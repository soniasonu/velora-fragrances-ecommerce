# Copy this file to .env and fill in your real values.

DJANGO_SECRET_KEY=replace-with-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL — create the database first:
#   CREATE DATABASE velora_db CHARACTER SET utf8mb4;
DB_NAME=velora_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Your frontend's origin(s), comma-separated (Live Server default shown).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Groq free API key — https://console.groq.com (no card required)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Razorpay TEST MODE keys — https://dashboard.razorpay.com
# Sign up free, no business verification needed for test mode.
# Account & Settings -> API Keys -> Generate Test Key.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
